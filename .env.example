# ClearSky AI - Environment Configuration Example

# Backend Core Settings
PROJECT_NAME="ClearSky AI"
VERSION="1.0.0"
SECRET_KEY="clearsky-super-secret-key-production-grade-2026-environmental-intelligence"
DATABASE_URL="sqlite+aiosqlite:///./clearsky.db"

# AI Configuration (Optional: Leave blank to use ClearSky Grounded Environmental RAG)
GEMINI_API_KEY=""

# External Environmental APIs (Open-Meteo is free & keyless; OpenAQ optional)
OPENAQ_API_KEY=""

# Cache & Performance
AQI_CACHE_TTL_SECONDS=900

# CORS Origins (Comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "*"]
