# ClearSky AI - Environment Configuration Example

# Backend Core Settings
PROJECT_NAME="ClearSky AI"
VERSION="1.0.0"
SECRET_KEY="replace-with-secure-random-64-char-hex-secret"
DATABASE_URL="sqlite+aiosqlite:///./clearsky.db"

# Optional First-Time Admin Provisioning (if omitted, the first registered user becomes super_admin)
ADMIN_EMAIL=""
ADMIN_INITIAL_PASSWORD=""

# AI Configuration (Optional: Leave blank to use ClearSky Grounded Environmental RAG)
GEMINI_API_KEY=""

# External Environmental APIs (Open-Meteo is free & keyless; OpenAQ optional)
OPENAQ_API_KEY=""

# Cache & Performance
AQI_CACHE_TTL_SECONDS=900

# CORS Origins (JSON array of explicit allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","https://clearsky-ai-theta.vercel.app"]
